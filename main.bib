	pages = {3872--3882},
	publisher = {European Language Resources Association (ELRA)},
	title = {Development of Automatic Speech Recognition for the Documentation of {C}ook {I}slands {M}{\=a}ori},
	url = {https://aclanthology.org/2022.lrec-1.412},
	year = {2022},
